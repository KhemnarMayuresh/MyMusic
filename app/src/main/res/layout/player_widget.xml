<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#18133B" android:padding="12dp" android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Music Player" android:textColor="#FFFFFF" android:textSize="16sp" android:maxLines="2" />
    <Button android:id="@+id/widget_previous" android:layout_width="48dp" android:layout_height="48dp" android:text="|‹" android:contentDescription="Previous song" />
    <Button android:id="@+id/widget_play" android:layout_width="48dp" android:layout_height="48dp" android:text="▶" android:contentDescription="Play or pause" />
    <Button android:id="@+id/widget_next" android:layout_width="48dp" android:layout_height="48dp" android:text="›|" android:contentDescription="Next song" />
</LinearLayout>
