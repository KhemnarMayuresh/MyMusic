<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp" android:gravity="center" android:background="@drawable/widget_light" android:orientation="vertical"><ImageView android:id="@+id/widget_art" android:visibility="gone" android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/ic_music" android:scaleType="centerCrop" android:contentDescription="Open player"/><TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Music Player" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:gravity="center" android:maxLines="1" android:ellipsize="end"/><TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your music, your way" android:textColor="#D6CCBF" android:textSize="12sp" android:visibility="gone" android:maxLines="1" android:ellipsize="end"/><LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center" android:orientation="horizontal"><ImageButton android:id="@+id/widget_favorite" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:padding="6dp" android:background="@android:color/transparent" android:src="@drawable/ic_widget_favorite" android:contentDescription="favorite"/><ImageButton android:id="@+id/widget_previous" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:padding="6dp" android:background="@android:color/transparent" android:src="@drawable/ic_widget_previous" android:contentDescription="previous"/><ImageButton android:id="@+id/widget_play" android:layout_width="36dp" android:layout_height="36dp" android:padding="6dp" android:background="@drawable/widget_play_circle" android:src="@drawable/ic_widget_play" android:contentDescription="