<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="8dp" android:background="@drawable/widget_art_background" android:gravity="center_vertical" android:orientation="horizontal">
    <FrameLayout android:layout_width="0dp" android:layout_weight="0.42" android:layout_height="match_parent">
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_record" android:scaleType="fitCenter" android:importantForAccessibility="no"/>
        <FrameLayout android:layout_width="54dp" android:layout_height="54dp" android:layout_gravity="center">
            <ImageView android:id="@+id/widget_art" android:layout_width="54dp" android:layout_height="54dp" android:src="@drawable/brand_icon" android:background="@drawable/widget_cover_circle" android:clipToOutline="true" android:scaleType="centerCrop" android:contentDescription="Open player"/>
        </FrameLayout>
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="0.58" android:layout_height="match_parent" android:layout_marginStart="10dp" android:gravity="center_vertical" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="My Music" android:textSize="15sp" android:textColor="#FFFFFF" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textStyle="bold"/>
                <TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your music, your way" android:textSize="11sp" android:textColor="#C8C1E7" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="4dp"/>
            </LinearLayout>
            <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/widget_equalizer" android:importantForAccessibility="no"/>
        </LinearLayout>
        <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:progressDrawable="@drawable/widget_progress" android:max="1000" android:progress="0"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="20dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/widget_elapsed" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="0:00" android:textColor="#C8C1E7" android:textSize="10sp"/>
            <TextView android:id="@+id/widget_duration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0:00" android:textColor="#C8C1E7" android:textSize="10sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/widget_favorite" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:padding="5dp" android:scaleType="fitCenter" android:background="@android:color/transparent" android:src="@drawable/ic_widget_favorite" android:contentDescription="favorite"/>
            <ImageButton android:id="@+id/widget_previous" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:padding="5dp" android:scaleType="fitCenter" android:background="@android:color/transparent" android:src="@drawable/ic_widget_previous" android:contentDescription="previous"/>
            <ImageButton android:id="@+id/widget_play" android:layout_width="44dp" android:layout_height="44dp" android:padding="11dp" android:scaleType="fitCenter" android:background="@drawable/widget_play_circle" android:src="@drawable/ic_widget_play" android:contentDescription="play"/>
            <ImageButton android:id="@+id/widget_next" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:padding="5dp" android:scaleType="fitCenter" android:background="@android:color/transparent" android:src="@drawable/ic_widget_next" android:contentDescription="next"/>
            <ImageButton android:id="@+id/widget_queue" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:padding="5dp" android:scaleType="fitCenter" android:background="@android:color/transparent" android:src="@drawable/ic_widget_queue" android:contentDescription="queue"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
